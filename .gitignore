!/data/audio/_canonical/*/*.mp3
!results/baseline/
results/baseline/*
!results/baseline/*.txt
!results/baseline/*.json
!results/baseline/*.jsonl
!results/baseline/*.patch
# Same reasoning as !results/cell3/*.log below: phi4mm_probe_FAILED.log is the only
# record of the Phi-4 OOM that PRE_REGISTRATION.md §10 cites, and minicpmo45_run.log is
# the only progress trace of the 1000-row run.
!results/baseline/*.log

# Cross-model capacity control and latency benchmark: predictions + manifests
# are the evidence the results docs cite, so they are tracked.
!results/capacity/
results/capacity/*
!results/capacity/*.json
!results/capacity/*.jsonl
!results/bench/
results/bench/*
!results/bench/*.json
!results/bench/*.jsonl

# Cell 3 (fine-tuned, audio-only) predictions, run manifest, and training log.
# train.log is the only record of the loss curve -- the run used --report_to none.
!results/cell3/
results/cell3/*
!results/cell3/*.json
!results/cell3/*.jsonl
!results/cell3/*.log
